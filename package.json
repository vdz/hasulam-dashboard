{
  "name": "hasulam-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && node scripts/check-lint-exceptions.mjs",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,realtime,storage-api,postgres-meta",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/db/types.gen.ts",
    "db:types:check": "node scripts/check-types-drift.mjs",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run db:types:check && npm run test:rls && npm run build && npm run secrets:check && npm run e2e",
    "secrets:check": "node scripts/check-client-secrets.mjs --bundle"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.28",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
